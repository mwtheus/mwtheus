##

/* ============ TOKENS ============ */
:root {
  --bg: #e9e7e1;
  --panel: #f4f2ec;
  --border: #d6d1c6;
  --text: #23262d;
  --text-dim: #5c626e;
  --accent: #b45309;
  --accent-dim: #a97d2e;
  --accent-2: #0f766e;
  --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --font-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --tabbar-h: 52px;
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--tabbar-h) + 16px);
}
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  * {
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }
}
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  line-height: 1.6;
}
a {
  color: inherit;
}
::selection {
  background: var(--accent);
  color: #ffffff;
}
:focus-visible {
  outline: 2px solid var(--accent-2);
  outline-offset: 3px;
}
code {
  font-family: var(--font-mono);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.1em 0.4em;
  font-size: 0.9em;
  color: var(--accent-2);
}
/* ============ TABBAR ============ */
.tabbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  height: var(--tabbar-h);
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 0 20px;
  background: rgba(233, 231, 225, 0.88);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}
.tabbar__brand {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  color: var(--accent);
  font-weight: 600;
  white-space: nowrap;
}
.tabbar__tabs {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  scrollbar-width: none;
  height: 100%;
  padding-top: 5px;
}
.tabbar__tabs::-webkit-scrollbar {
  display: none;
}
.tab {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-dim);
  text-decoration: none;
  padding: 8px 14px;
  border-radius: 6px 6px 0 0;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid transparent;
  transition: color 0.15s ease, background 0.15s ease;
}
.tab:hover {
  color: var(--text);
}
.tab.is-active {
  color: var(--text);
  background: var(--panel);
  border-color: var(--border);
  border-bottom-color: var(--panel);
}
.tab__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-2);
  flex: none;
}
.lang-toggle {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--text-dim);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 6px 10px;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.lang-toggle:hover {
  border-color: var(--accent);
  color: var(--text);
}
.lang-toggle__opt {
  color: var(--text-dim);
  opacity: 0.5;
  transition: opacity 0.15s ease, color 0.15s ease;
}
.lang-toggle__opt.is-active {
  opacity: 1;
  color: var(--accent);
}
.lang-toggle__sep {
  color: var(--border);
}
/* ============ LAYOUT / SECTIONS ============ */
main {
  max-width: 760px;
  margin: 0 auto;
  padding: var(--tabbar-h) 24px 0;
}
.section {
  padding: 96px 0 64px;
  border-bottom: 1px solid var(--border);
}
.section:last-child {
  border-bottom: none;
}
.line-comment {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-dim);
  margin: 0 0 12px;
}
.line-comment::before {
  content: "// ";
  color: var(--accent-dim);
}
.section__title {
  font-family: var(--font-mono);
  font-size: 1.6rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 40px;
  color: var(--text);
}
/* ============ HERO ============ */
.hero {
  padding-top: 72px;
}
.hero__avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid var(--accent);
  margin: 0 0 24px;
  box-shadow: 0 0 0 4px rgba(180, 83, 9, 0.15);
}
.hero__avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.hero__title {
  font-family: var(--font-mono);
  font-size: clamp(2.4rem, 7vw, 4rem);
  font-weight: 700;
  margin: 0 0 8px;
  letter-spacing: -0.02em;
}
.cursor {
  color: var(--accent);
  animation: blink 1s step-end infinite;
}
@keyframes blink {
  50% {
    opacity: 0;
  }
}
.hero__subtitle {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  color: var(--accent-2);
  min-height: 1.6em;
  margin: 0 0 24px;
}
.hero__desc {
  max-width: 520px;
  color: var(--text-dim);
  font-size: 1.05rem;
  margin: 0 0 36px;
}
.hero__actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}
.hero__socials {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 28px;
}
.hero__socials a {
  display: inline-flex;
}
.hero__socials img {
  height: 28px;
  width: auto;
}
.btn {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 6px;
  border: 1px solid var(--border);
  transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  display: inline-block;
}
.btn:hover {
  transform: translateY(-2px);
}
.btn--primary {
  background: var(--accent);
  color: #ffffff;
  border-color: var(--accent);
  font-weight: 600;
}
.btn--primary:hover {
  background: #92400e;
}
.btn--ghost {
  color: var(--text);
}
.btn--ghost:hover {
  border-color: var(--accent-2);
  color: var(--accent-2);
}
/* ============ SOBRE ============ */
.about p {
  color: var(--text-dim);
  font-size: 1.02rem;
  margin: 0 0 18px;
}
.about strong {
  color: var(--text);
}
.about a {
  color: var(--accent-2);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}
.skill {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 7px 12px;
  border-radius: 999px;
}
.skill--primary {
  color: #ffffff;
  background: var(--accent);
  border-color: var(--accent);
  font-weight: 600;
}
/* ============ PROJETOS ============ */
.projects {
  display: grid;
  gap: 20px;
}
.project-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 220px 1fr;
  transition: border-color 0.15s ease;
}
.project-card:hover {
  border-color: var(--accent-dim);
}
.project-card__media {
  background: #ddd9cf;
  min-height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.project-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.project-card__media--placeholder {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-dim);
  text-align: center;
  padding: 12px;
}
.project-card__body {
  padding: 22px 24px;
}
.project-card__title {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  margin: 0 0 8px;
  color: var(--text);
}
.project-card__period {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--accent-dim);
  margin: -4px 0 10px;
}
.project-card__desc {
  color: var(--text-dim);
  font-size: 0.95rem;
  margin: 0 0 14px;
}
.project-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}
.project-card__tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--accent-2);
  background: rgba(15, 118, 110, 0.08);
  border: 1px solid rgba(15, 118, 110, 0.25);
  padding: 3px 9px;
  border-radius: 999px;
}
.project-card__link {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid transparent;
}
.project-card__link:hover {
  border-bottom-color: var(--accent);
}
@media (max-width: 640px) {
  .project-card {
    grid-template-columns: 1fr;
  }
  .project-card__media {
    min-height: 140px;
  }
}
/* ============ CONTATO ============ */
.contact__desc {
  color: var(--text-dim);
  font-size: 1.02rem;
  margin: 0 0 32px;
}
.contact__links {
  display: flex;
  flex-direction: column;
  gap: 1px;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}
.contact__link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  background: var(--panel);
  text-decoration: none;
  transition: background 0.15s ease;
}
.contact__link:hover {
  background: #e6e3da;
}
.contact__label {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-dim);
}
.contact__value {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  color: var(--accent-2);
}
/* ============ FOOTER ============ */
.footer {
  max-width: 760px;
  margin: 0 auto;
  padding: 32px 24px 64px;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 0.78rem;
}
.yrkit-shots {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  margin: 0 0 24px;
}
.yrkit-shots img {
  width: 100%;
  height: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
}
.yrkit-shots img.yrkit-shots__logo {
  width: 56px;
  height: 56px;
  border: none;
  border-radius: 0;
}
.yrkit-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 4px 0 24px;
  padding: 14px 28px;
  border-radius: 999px;
  font-size: 0.95rem;
  letter-spacing: 0.01em;
  box-shadow: 0 8px 20px rgba(180, 83, 9, 0.22);
}
.yrkit-cta::after {
  content: "→";
  transition: transform 0.15s ease;
}
.yrkit-cta:hover::after {
  transform: translateX(4px);
}
.yrkit-docs-link {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--accent-2);
  text-decoration: none;
  border-bottom: 1px dashed rgba(89, 216, 200, 0.4);
  padding-bottom: 2px;
  margin-bottom: 20px;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.yrkit-docs-link:hover {
  color: var(--text);
  border-bottom-color: var(--accent-2);
}
.yrkit-preview {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  background: var(--panel);
  margin: 8px 0 28px;
}
.yrkit-preview__bar {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  background: #e6e3da;
  border-bottom: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-dim);
}
.yrkit-preview__bar::before {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 16px 0 0 var(--accent-dim), 32px 0 0 var(--accent-2);
  margin-right: 38px;
}
.yrkit-preview__filename::before {
  content: "// ";
  color: var(--accent-dim);
}
.yrkit-preview__editor-wrap {
  position: relative;
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: 1fr;
  height: 40svh;
  max-height: 40svh;
  min-height: 220px;
  background: #ddd9cf;
  border-right: 1px solid var(--border);
  transition: box-shadow 0.15s ease;
}
.yrkit-preview__editor-wrap:focus-within {
  box-shadow: inset 3px 0 0 var(--accent-2);
}
/* Goteira com os números de linha */
.yrkit-preview__gutter {
  overflow: hidden;
  padding: 16px 10px 16px 14px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  line-height: 1.6;
  color: #a89f8b;
  text-align: right;
  white-space: pre;
  user-select: none;
  background: rgba(35, 38, 45, 0.05);
}
.yrkit-preview__scroll {
  position: relative;
  overflow: hidden;
  min-height: 0;
}
/* Espelho (texto visível) + textarea (texto transparente, só captura o input) */
.yrkit-preview__mirror,
.yrkit-preview__editor {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 16px 18px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  line-height: 1.6;
  tab-size: 2;
  white-space: pre;
}
.yrkit-preview__mirror {
  overflow: hidden;
  color: var(--text);
  pointer-events: none;
}
.yrkit-preview__editor {
  width: 100%;
  height: 100%;
  overflow: auto;
  color: transparent;
  background: transparent;
  border: none;
  resize: none;
  caret-color: transparent;
}
.yrkit-preview__editor:focus {
  outline: none;
}
.yrkit-preview__editor::selection {
  background: rgba(180, 83, 9, 0.28);
}
/* Cursor piscando, posicionado na altura do caret */
.yrkit-preview__caret {
  display: inline-block;
  width: 2px;
  height: 1.05em;
  margin-right: -2px;
  vertical-align: text-bottom;
  background: var(--accent);
  animation: yrkit-caret 1s step-end infinite;
}
@keyframes yrkit-caret {
  50% {
    opacity: 0;
  }
}
.yrkit-preview__frame {
  width: 100%;
  height: 100%;
  max-height: 40svh;
  min-height: 220px;
  background: #ffffff;
  border: none;
}
@media (max-width: 620px) {
  .yrkit-preview {
    grid-template-columns: 1fr;
  }
  .yrkit-preview__editor-wrap {
    border-right: none;
    border-bottom: 1px solid var(--border);
    height: 40svh;
    min-height: 200px;
  }
  .yrkit-preview__frame {
    height: 40svh;
    min-height: 200px;
  }
}
/* ============ EXTRA SECTIONS ============ */
.code-block {
  font-family: var(--font-mono);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 14px 16px;
  margin: 0 0 24px;
  overflow-x: auto;
}
.code-block code {
  background: none;
  border: none;
  padding: 0;
  color: var(--accent-2);
  font-size: 0.85rem;
}
.section__subtitle {
  position: relative;
  font-family: var(--font-mono);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text);
  margin: 60px 0 22px;
  padding-left: 16px;
}
.section__subtitle::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.1em;
  bottom: 0.15em;
  width: 3px;
  border-radius: 2px;
  background: var(--accent);
}
/* A primeira subseção logo após o título não precisa do grande respiro */
.section__title + .section__subtitle {
  margin-top: 0;
}
.stats-table {
  border-collapse: collapse;
  width: 100%;
  margin: 0 0 24px;
}
.stats-table td {
  border: 1px solid var(--border);
  padding: 10px 14px;
  font-size: 0.95rem;
  color: var(--text-dim);
}
.stats-table td:first-child {
  color: var(--text);
  white-space: nowrap;
}
.stats-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 0 0 28px;
}
.stats-images img {
  max-width: 100%;
  height: auto;
}
.stats-group {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--text-dim);
  margin: 34px 0 14px;
}
.stats-group::before {
  content: "# ";
  color: var(--accent-dim);
}
.stats-group:first-of-type,
.section__subtitle + .stats-group {
  margin-top: 18px;
}
.stats-group a {
  color: var(--accent-2);
  text-decoration: none;
  border-bottom: 1px dashed rgba(15, 118, 110, 0.4);
  padding-bottom: 1px;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.stats-group a:hover {
  color: var(--text);
  border-bottom-color: var(--accent-2);
}
.badge-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 0 0 20px;
}
.badge-row img {
  height: 32px;
  width: auto;
}
.badge--avatar {
  height: 44px !important;
  border-radius: 50%;
}

@@

